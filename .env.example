# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Demo mode — enables /demo/* endpoints (FakeClock, time advance)
# Set to false in any non-local environment
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./modelyo_support.db

# Logging
LOG_LEVEL=INFO

# Security — per-tenant webhook secrets are defined in config/tenants.yaml
# This is the fallback secret used only in tests; never use in production
WEBHOOK_SIGNING_SECRET=change-me-before-use

# Replay protection — events older/newer than this many seconds are rejected
REPLAY_TOLERANCE_SECONDS=300
